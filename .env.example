# Server Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication
# JWT_SECRET: Strong secret for signing session tokens (if omitted, an auto-generated 64-char key is stored securely in settings)
JWT_SECRET=your_jwt_secret_key_change_in_production

# DEFAULT_ADMIN_PIN: Initial Admin PIN when creating a fresh database (default: 1234)
# Note: PIN is immediately hashed with bcrypt upon first initialization.
DEFAULT_ADMIN_PIN=1234
