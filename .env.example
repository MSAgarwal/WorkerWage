# WorkerWage Environment Configuration Example
# Copy this file to .env and configure for your environment:
# cp .env.example .env

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Database File Path (Default: ./attendance.db)
DB_PATH=./attendance.db

# JWT Signing Secret (Leave empty to auto-generate a secure random 32-byte secret on first startup)
JWT_SECRET=

# Initial Admin PIN (Optional: if omitted, you will be prompted to create an Admin PIN on first run)
DEFAULT_ADMIN_PIN=

# Allowed CORS Origins (comma-separated, optional)
# ALLOWED_ORIGINS=http://localhost:5000,http://192.168.1.8:5000

# Rate Limiting & DoS Protection (Default: 300 req/min for general API, 12 req/min for Auth)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=12

# Automated Scheduled Backups (Atomic WAL-flushed snapshots into backups/)
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
